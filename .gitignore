# Virtual environments
.venv/
venv/

# Python bytecode & caches
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# OS generated
.DS_Store

# Smoke testing and release artifacts
*_smoke*
submission/
release_assets/
*.zip

# Models (ignore all models except baseline.joblib and .gitkeep)
models/*
!models/.gitkeep
